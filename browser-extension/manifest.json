{
  "manifest_version": 3,
  "name": "浏览器首页一键收藏",
  "version": "1.0.0",
  "description": "将当前标签页保存到本机浏览器首页。",
  "permissions": ["tabs", "storage", "contextMenus", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:3011/*",
    "http://localhost:3011/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "收藏到浏览器首页",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
